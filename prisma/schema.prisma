// Peak Process Partners — Onboarding Platform
// Prisma schema. Database: PostgreSQL (Neon in production). This file plus
// the SQL in prisma/migrations/ are the source of truth; the migration also
// carries the CHECK constraints Prisma's DSL can't express. Completion % and
// current step aren't stored (they're derived from the data), and Aadhaar /
// PAN / UAN are stored only as AES-256-GCM ciphertext.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Neon: DATABASE_URL is the pooled connection (host contains "-pooler"),
  // DIRECT_URL the direct one, used by `prisma migrate`. Locally both can
  // be the same URL.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum EmployeeStatus {
  in_progress
  submitted
}

enum Gender {
  female
  male
  non_binary        @map("non-binary")
  prefer_not_to_say @map("prefer-not-to-say")
}

enum ReferenceType {
  primary
  secondary
}

enum CoverageType {
  self
  self_spouse @map("self-spouse")
  self_family @map("self-family")
}

enum DocumentType {
  identityProof
  addressProof
  resume
  educationalCertificates
  offerLetter
}

enum DocumentStatus {
  pending
  uploading
  uploaded
  error
  provided
}

/// One row per onboarding session — the anchor/identity row, created the
/// first time a browser hits the app (before any form data exists) and
/// looked up by an httpOnly session cookie. There is no login in the
/// current app, so this row *is* the "user" for now.
model Employee {
  id                  String         @id @default(uuid()) @db.Char(36)
  sessionToken        String         @unique @default(uuid()) @map("session_token") @db.Char(36)
  fullName            String?        @map("full_name") @db.VarChar(255)
  status              EmployeeStatus @default(in_progress)
  submissionReference String?        @unique @map("submission_reference") @db.VarChar(32)
  submittedAt         DateTime?      @map("submitted_at") @db.Timestamptz(3)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  personalInformation PersonalInformation?
  references          EmployeeReference[]
  emergencyContact    EmergencyContact?
  healthInsurance     HealthInsurance?
  documents           EmployeeDocument[]
  /// The application this person was hired from (set by "Mark as hired").
  /// Null for onboarding sessions that started without an application.
  sourceApplicationId String?              @unique(map: "uq_employees_source_application") @map("source_application_id") @db.Char(36)
  sourceApplication   JobApplication?      @relation("EmployeeSourceApplication", fields: [sourceApplicationId], references: [id], onDelete: SetNull)
  hiredApplication    JobApplication?      @relation("ApplicationEmployee")
  onboardingInvites   OnboardingInvite[]

  @@map("employees")
}

/// 1:1 with Employee — "Personal Information" step.
model PersonalInformation {
  employeeId    String    @id @map("employee_id") @db.Char(36)
  firstName     String?   @map("first_name") @db.VarChar(100)
  lastName      String?   @map("last_name") @db.VarChar(100)
  dateOfBirth   DateTime? @map("date_of_birth") @db.Date
  gender        Gender?
  personalEmail String?   @map("personal_email") @db.VarChar(255)
  phone         String?   @db.VarChar(20)
  homeAddress   String?   @map("home_address") @db.VarChar(500)

  /// AES-256-GCM ciphertext (see lib/security/encryption.ts) — never read
  /// or written as plaintext. Stored as bytea.
  aadhaarNumberEnc Bytes? @map("aadhaar_number_enc")
  panNumberEnc     Bytes? @map("pan_number_enc")
  uanNumberEnc     Bytes? @map("uan_number_enc")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("personal_information")
}

/// Exactly two fixed slots per employee ("primary" / "secondary") —
/// modeled as a typed child row rather than ten flat columns, enforced via
/// the unique key on (employeeId, referenceType).
model EmployeeReference {
  id            String        @id @default(uuid()) @db.Char(36)
  employeeId    String        @map("employee_id") @db.Char(36)
  referenceType ReferenceType @map("reference_type")
  name          String?       @db.VarChar(150)
  relationship  String?       @db.VarChar(100)
  company       String?       @db.VarChar(150)
  email         String?       @db.VarChar(255)
  phone         String?       @db.VarChar(20)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, referenceType], map: "uq_employee_references_type")
  @@index([employeeId], map: "idx_employee_references_employee")
  @@map("employee_references")
}

/// 1:1 with Employee — "Emergency Contact" step.
model EmergencyContact {
  employeeId        String   @id @map("employee_id") @db.Char(36)
  name              String?  @db.VarChar(150)
  relationship      String?  @db.VarChar(100)
  primaryPhone      String?  @map("primary_phone") @db.VarChar(20)
  secondaryPhone    String?  @map("secondary_phone") @db.VarChar(20)
  sameAsHomeAddress Boolean  @default(false) @map("same_as_home_address")
  address           String?  @db.VarChar(500)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("emergency_contacts")
}

/// 1:1 with Employee — "Health Insurance" step (coverage + nominee only;
/// dependents are a separate child table below).
model HealthInsurance {
  employeeId          String        @id @map("employee_id") @db.Char(36)
  coverageType        CoverageType? @map("coverage_type")
  nomineeName         String?       @map("nominee_name") @db.VarChar(150)
  nomineeRelationship String?       @map("nominee_relationship") @db.VarChar(100)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  employee   Employee                   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  dependents HealthInsuranceDependent[]

  @@map("health_insurance")
}

/// Up to 5 per employee (enforced in the API route, not the DB: CHECK
/// constraints can't express cross-row cardinality rules).
model HealthInsuranceDependent {
  id           String   @id @default(uuid()) @db.Char(36)
  employeeId   String   @map("employee_id") @db.Char(36)
  name         String   @db.VarChar(150)
  relationship String   @db.VarChar(100)
  dateOfBirth  DateTime @map("date_of_birth") @db.Date
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  healthInsurance HealthInsurance @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)

  @@index([employeeId], map: "idx_health_insurance_dependents_employee")
  @@map("health_insurance_dependents")
}

/// One row per document type per employee ("Documents" step). File bytes
/// are never stored here — storagePath points at an object-storage
/// key/URL once that's wired up (see write-up).
model EmployeeDocument {
  id           String         @id @default(uuid()) @db.Char(36)
  employeeId   String         @map("employee_id") @db.Char(36)
  documentType DocumentType   @map("document_type")
  fileName     String?        @map("file_name") @db.VarChar(255)
  fileSize     Int?           @map("file_size") @db.Integer
  mimeType     String?        @map("mime_type") @db.VarChar(127)
  storagePath  String?        @map("storage_path") @db.VarChar(1024)
  status       DocumentStatus @default(pending)
  errorMessage String?        @map("error_message") @db.VarChar(500)
  uploadedAt   DateTime?      @map("uploaded_at") @db.Timestamptz(3)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, documentType], map: "uq_employee_documents_type")
  @@index([employeeId], map: "idx_employee_documents_employee")
  @@map("employee_documents")
}

// ============================================================================
// Recruitment (jobs + applications) — additive, independent of the models
// above. A job applicant is NOT an Employee: nothing here relates to
// Employee or its children.
// ============================================================================

enum EmploymentType {
  full_time
  part_time
  contract
  internship
}

enum WorkMode {
  onsite
  hybrid
  remote
}

enum JobStatus {
  draft
  published
  closed
}

enum ApplicationStatus {
  applied
  under_review
  shortlisted
  interview
  /// Only entered through the offer form (POST .../offer), never a plain move.
  offered
  /// Hired. Only reachable from "offered", through "Mark as hired".
  selected
  rejected
}

/// Why an application was rejected. Labels and keyboard shortcuts live in
/// lib/recruitment/rejection.ts.
enum RejectReason {
  skills_experience
  location_workmode
  compensation
  failed_knockout
  stronger_candidates
  incomplete_unresponsive
  withdrew
  other
}

enum ApplicationDocumentType {
  resume
  other
}

/// HR/Admin profile. Sign-in itself is handled by Clerk (lib/server/adminSession.ts):
/// a signed-in Clerk user whose verified email is in ADMIN_EMAILS gets a row
/// here on first visit, linked by clerkUserId. The row exists so jobs and
/// status changes can keep pointing at "who did it".
model AdminUser {
  id          String   @id @default(uuid()) @db.Char(36)
  clerkUserId String?  @unique @map("clerk_user_id") @db.VarChar(64)
  email       String   @unique @db.VarChar(255)
  fullName    String   @map("full_name") @db.VarChar(150)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  jobsCreated    Job[]
  statusChanges  ApplicationStatusHistory[]
  notes          ApplicationNote[]
  auditLogs      AdminAuditLog[]
  invitesCreated OnboardingInvite[]

  @@map("admin_users")
}

/// One row per job opening. requiredSkills/preferredSkills are JSON string
/// arrays (tag/chip UI), not flat text. No slug: the app routes by id.
model Job {
  id                 String         @id @default(uuid()) @db.Char(36)
  title              String         @db.VarChar(200)
  department         String?        @db.VarChar(150)
  location           String?        @db.VarChar(150)
  employmentType     EmploymentType @map("employment_type")
  workMode           WorkMode       @map("work_mode")
  experienceMinYears Int?           @map("experience_min_years") @db.SmallInt
  experienceMaxYears Int?           @map("experience_max_years") @db.SmallInt
  salaryMin          Int?           @map("salary_min") @db.Integer
  salaryMax          Int?           @map("salary_max") @db.Integer
  salaryPublic       Boolean        @default(false) @map("salary_public")
  overview           String?        @db.Text
  responsibilities   String?        @db.Text
  requirements       String?        @db.Text
  requiredSkills     Json?          @map("required_skills")
  preferredSkills    Json?          @map("preferred_skills")
  education          String?        @db.VarChar(255)
  benefits           String?        @db.Text
  deadline           DateTime?      @db.Date
  status             JobStatus      @default(draft)
  /// 0–2 Yes/No screening questions: [{ id, label, qualifyingAnswer }].
  /// Validated by lib/recruitment/knockouts.ts.
  knockouts          Json?
  createdBy          String?        @map("created_by") @db.Char(36)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  publishedAt        DateTime?      @map("published_at") @db.Timestamptz(3)
  closedAt           DateTime?      @map("closed_at") @db.Timestamptz(3)

  creator      AdminUser?       @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  applications JobApplication[]

  @@index([status], map: "idx_jobs_status")
  @@index([deadline], map: "idx_jobs_deadline")
  @@map("jobs")
}

/// One row per person; found-or-created by email so one candidate can apply
/// to multiple jobs (see JobApplication) — never linked to a job directly.
model Candidate {
  id              String   @id @default(uuid()) @db.Char(36)
  firstName       String   @map("first_name") @db.VarChar(100)
  lastName        String   @map("last_name") @db.VarChar(100)
  email           String   @unique @db.VarChar(255)
  phone           String?  @db.VarChar(20)
  location        String?  @db.VarChar(150)
  experienceYears Int?     @map("experience_years") @db.SmallInt
  education       String?  @db.VarChar(255)
  linkedinUrl     String?  @map("linkedin_url") @db.VarChar(500)
  portfolioUrl    String?  @map("portfolio_url") @db.VarChar(500)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  applications JobApplication[]

  @@map("candidates")
}

/// One row per (job, candidate) — the unique key blocks double-applying to
/// the same job. Only ever holds the CURRENT status; see
/// ApplicationStatusHistory for the transition log.
model JobApplication {
  id               String            @id @default(uuid()) @db.Char(36)
  jobId            String            @map("job_id") @db.Char(36)
  candidateId      String            @map("candidate_id") @db.Char(36)
  status           ApplicationStatus @default(applied)
  coverLetter      String?           @map("cover_letter") @db.Text
  appliedAt        DateTime          @default(now()) @map("applied_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// When the application entered its current status (set on create and on
  /// every status change) — drives "days in stage".
  stageEnteredAt   DateTime          @default(now()) @map("stage_entered_at") @db.Timestamptz(3)
  /// Set only while status = rejected (see lib/recruitment/rejection.ts).
  /// CHECK chk_job_applications_reject_reason (raw SQL in migration
  /// rejection_reasons_stage_rules) enforces that, and that "other" has a note.
  rejectReason     RejectReason?     @map("reject_reason")
  rejectNote       String?           @map("reject_note") @db.Text
  /// Snapshot of the job's screening questions with the candidate's answers:
  /// [{ id, label, qualifyingAnswer, answer }]. knockoutFlagged is computed on
  /// the server (computeKnockoutFlag) and never auto-rejects.
  knockoutAnswers  Json?             @map("knockout_answers")
  knockoutFlagged  Boolean           @default(false) @map("knockout_flagged")
  /// When the applicant agreed to the privacy notice, and which version
  /// (PRIVACY_CONSENT_VERSION in lib/recruitment/consent.ts). Null on
  /// applications made before consent was collected.
  consentedAt      DateTime?         @map("consented_at") @db.Timestamptz(3)
  consentVersion   String?           @map("consent_version") @db.VarChar(20)
  /// Set with the move into "offered" (lib/recruitment/offers.ts):
  /// { salary, currency, startDate, expiresOn, note }.
  offerDetails     Json?             @map("offer_details")
  offerSentAt      DateTime?         @map("offer_sent_at") @db.Timestamptz(3)
  /// The Employee created by "Mark as hired". Unique: one hire per application.
  employeeId       String?           @unique(map: "uq_job_applications_employee") @map("employee_id") @db.Char(36)
  employee         Employee?         @relation("ApplicationEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  sourceOfEmployee Employee?         @relation("EmployeeSourceApplication")

  job           Job                        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidate     Candidate                  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  documents     ApplicationDocument[]
  statusHistory ApplicationStatusHistory[]
  notes         ApplicationNote[]

  @@unique([jobId, candidateId], map: "uq_job_applications_job_candidate")
  @@index([jobId], map: "idx_job_applications_job")
  @@index([candidateId], map: "idx_job_applications_candidate")
  @@index([status], map: "idx_job_applications_status")
  @@map("job_applications")
}

/// Resume/other uploads, scoped to the application (not the candidate), so
/// each application keeps the files it was sent with. File bytes live in
/// object storage (lib/server/fileStorage.ts); storagePath is never a public URL.
model ApplicationDocument {
  id            String                  @id @default(uuid()) @db.Char(36)
  applicationId String                  @map("application_id") @db.Char(36)
  documentType  ApplicationDocumentType @map("document_type")
  fileName      String                  @map("file_name") @db.VarChar(255)
  fileSize      Int                     @map("file_size") @db.Integer
  mimeType      String                  @map("mime_type") @db.VarChar(127)
  storagePath   String                  @map("storage_path") @db.VarChar(1024)
  uploadedAt    DateTime                @default(now()) @map("uploaded_at") @db.Timestamptz(3)

  application JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId], map: "idx_application_documents_application")
  @@map("application_documents")
}

/// Append-only log of every status transition. oldStatus is NULL only for
/// the very first row (the "applied" state recorded at submission).
model ApplicationStatusHistory {
  id               String             @id @default(uuid()) @db.Char(36)
  applicationId    String             @map("application_id") @db.Char(36)
  oldStatus        ApplicationStatus? @map("old_status")
  newStatus        ApplicationStatus  @map("new_status")
  changedByAdminId String?            @map("changed_by_admin_id") @db.Char(36)
  changedAt        DateTime           @default(now()) @map("changed_at") @db.Timestamptz(3)
  /// Copied from the application on the transition into "rejected".
  rejectReason     RejectReason?      @map("reject_reason")
  rejectNote       String?            @map("reject_note") @db.Text

  application    JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedByAdmin AdminUser?     @relation(fields: [changedByAdminId], references: [id], onDelete: SetNull)

  @@index([applicationId], map: "idx_application_status_history_application")
  @@map("application_status_history")
}

/// HR notes on an application, with an optional 1–5 rating. body is capped at
/// 5000 characters by the API (lib/recruitment/notes.ts). A CHECK constraint
/// `chk_application_notes_rating` (rating NULL or 1–5) is added as raw SQL in
/// migration application_notes.
model ApplicationNote {
  id            String   @id @default(uuid()) @db.Char(36)
  applicationId String   @map("application_id") @db.Char(36)
  authorAdminId String?  @map("author_admin_id") @db.Char(36)
  body          String   @db.Text
  rating        Int?     @db.SmallInt
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  application JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  author      AdminUser?     @relation(fields: [authorAdminId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt], map: "idx_application_notes_application_created")
  @@map("application_notes")
}

/// One-time link that binds a browser to a hired Employee's onboarding
/// (/onboarding/start/[token]). Only the SHA-256 of the token is stored.
model OnboardingInvite {
  id               String    @id @default(uuid()) @db.Char(36)
  employeeId       String    @map("employee_id") @db.Char(36)
  tokenHash        String    @unique(map: "uq_onboarding_invites_token_hash") @map("token_hash") @db.Char(64)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt           DateTime? @map("used_at") @db.Timestamptz(3)
  createdByAdminId String?   @map("created_by_admin_id") @db.Char(36)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  employee  Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdBy AdminUser? @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([employeeId], map: "idx_onboarding_invites_employee")
  @@map("onboarding_invites")
}

/// Append-only record of sensitive admin actions (revealing government IDs,
/// hiring, team changes...). action is a dotted verb such as
/// "employee.reveal_ids"; entity/entityId name what it was done to.
model AdminAuditLog {
  id           String   @id @default(uuid()) @db.Char(36)
  actorAdminId String?  @map("actor_admin_id") @db.Char(36)
  action       String   @db.VarChar(64)
  entity       String   @db.VarChar(64)
  entityId     String?  @map("entity_id") @db.VarChar(64)
  meta         Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor AdminUser? @relation(fields: [actorAdminId], references: [id], onDelete: SetNull)

  @@index([entity, entityId], map: "idx_admin_audit_log_entity")
  @@index([createdAt], map: "idx_admin_audit_log_created")
  @@map("admin_audit_log")
}
