# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL (Neon in production). Prisma uses two URLs:
#   DATABASE_URL — the app's connection. On Neon use the *pooled* string
#                  (host contains "-pooler"), with ?sslmode=require.
#   DIRECT_URL   — used by `prisma migrate`. On Neon the direct (non-pooler)
#                  string. Locally, set both to the same URL.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/peak_process"
DIRECT_URL="postgresql://postgres:password@localhost:5432/peak_process"

# 32-byte (256-bit) key, base64-encoded, used for AES-256-GCM encryption of
# Aadhaar / PAN / UAN at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this key without a re-encryption migration will make existing
# encrypted values unreadable — treat it like a production secret, back it up
# securely, and never reuse it across environments.
ENCRYPTION_KEY=""

# Name of the httpOnly cookie used to identify an onboarding session.
# Optional — defaults to "ppp_session" if unset.
SESSION_COOKIE_NAME="ppp_session"

# HR/Admin sign-in is handled by Clerk (https://clerk.com).
# In local development you can leave both keys commented out: Clerk runs in
# "keyless" mode and creates temporary development keys (stored in .clerk/,
# which is git-ignored). For Vercel, copy both keys from the Clerk dashboard
# (API keys page).
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
# CLERK_SECRET_KEY="sk_test_..."

# Who may use the HR admin: comma-separated emails. A Clerk user gets admin
# access only if one of their *verified* emails is on this list.
ADMIN_EMAILS="hr@example.com"

# Object storage for resumes/application documents — an S3-compatible
# endpoint (e.g. a self-hosted MinIO instance). MINIO_ENDPOINT is the host
# only, no scheme (an "https://" prefix is added automatically).
MINIO_ENDPOINT=""
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""
MINIO_BUCKET=""
